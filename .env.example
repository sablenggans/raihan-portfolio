# =====================================================
# Environment Variables for Raihan Portfolio
#
# Isi nilai ini setelah membuat project Supabase.
# File ini akan di-commit ke repo sebagai contoh (dicaftakan dengan .gitignore rule !.env.example).
# JANGAN menyimpan service_role key di file ini atau commit ke repo.
# =====================================================

# URL project Supabase (dapat didapat dari Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Anonymous key untuk client-side (dari Supabase Dashboard > Settings > API)
# Key dimulai dengan "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Hanya digunakan untuk operasi baca/anon; tulis terlindungi oleh RLS.
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# (Opsional) Mode theme awal: "light" atau "dark"
# Default: light (akan di-overide oleh localStorage jika disimpan pengguna)
VITE_INITIAL_THEME="light"

# Catatan:
# - Setiap kali VITE_SUPABASE_URL atau VITE_SUPABASE_ANON_KEY berubah,
#   jalankan `npm run build` ulang untuk memperbarui bundle.
# - Gunakan `supabase start` untuk development lokal, atau buat project baru di supabase.co.
# - Admin dibuat manual melalui Supabase Dashboard > Authentication > Users > Add user.
#   Setelah user ditambahkan, tambahkan entri di tabel public.admin_users manually
#   atau melalui SQL: INSERT INTO admin_users (user_id) VALUES ('<auth-user-id>');
# - Service_role key tidak pernah dimasukkan ke variable VITE_*; hanya digunakan
#   di Edge Functions backend dan Supabase Dashboard SQL editor.